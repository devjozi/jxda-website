# Analytics
NEXT_PUBLIC_META_PIXEL_ID=1705999587410766
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Formspree
NEXT_PUBLIC_FORMSPREE_FORM_ID=your-formspree-form-id
# ========================================
# JX DISTRIBUTION - ENVIRONMENT CONFIG
# ========================================
# Copy this file to .env.local and fill in the values below
# For production (GitHub Actions), add these as GitHub Secrets

# ========================================
# REQUIRED: WhatsApp Configuration
# ========================================
# Your WhatsApp Business number (digits only, including country code)
# Ghana example: 233 54 661 3884 → 233546613884
NEXT_PUBLIC_WHATSAPP_NUMBER=233XXXXXXXXX

# Default message shown in WhatsApp chats
NEXT_PUBLIC_WHATSAPP_MESSAGE=Hi, I'm interested in JX Distribution services

# ========================================
# ESSENTIAL: Contact Form (Static Hosting)
# ========================================
# For Hostinger static export, use Formspree or Getform
# 
# Option 1: Formspree (recommended)
# 1. Sign up at https://formspree.io (free)
# 2. Create new form for contact page
# 3. Copy the form endpoint
# 4. Set below: https://formspree.io/f/YOUR_FORM_ID
# 
# Option 2: Getform
# 1. Sign up at https://getform.io
# 2. Create form
# 3. Copy endpoint: https://getform.io/f/YOUR_FORM_ID
#
# Leave blank if using Node.js hosting (will use /api/contact route)
NEXT_PUBLIC_CONTACT_FORM_ACTION=

# ========================================
# OPTIONAL: Email API (Node.js hosting only)
# ========================================
# Only needed if deploying to Node.js hosting (e.g., Vercel, Hostinger Business)
# Ignored in static export mode
# Get free API key at https://resend.com
RESEND_API_KEY=re_your_api_key_here

# Email address for contact form submissions (backend only)
CONTACT_EMAIL_TO=info@jxdistributionafrica.com

# ========================================
# OPTIONAL: Site Configuration
# ========================================
# Current site URL (for dynamic links if needed)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ========================================
# FUTURE: Database
# ========================================
# DATABASE_URL=postgresql://user:password@host:port/database

# ========================================
# FUTURE: Payment Provider
# ========================================
# PAYSTACK_PUBLIC_KEY=pk_test_xxxxx
# PAYSTACK_SECRET_KEY=sk_test_xxxxx

# ========================================
# FUTURE: Analytics
# ========================================
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
